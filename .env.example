# Experient — Root .env (single source of truth for all services)
# Copy to .env and fill in your values. Never commit .env files.
#
# ── Docker (local infra) ───────────────────────────────────────────────────────
# Docker (local infra)
# npm run infra* uses scripts/docker-compose.mjs — ignores ~/.zshrc DOCKER_DEFAULT_PLATFORM
# so Apple Silicon builds stay linux/arm64. For amd64 parity with OCI:
#   EXPERIENT_DOCKER_PLATFORM=linux/amd64 npm run infra:reset
# DOCKER_BUILDKIT=1
# COMPOSE_DOCKER_CLI_BUILD=1
# DOCKER_DEFAULT_PLATFORM=linux/amd64
#
# Both the Node.js backend and the Python agents service read from this file:
#   • Node backend:  require('dotenv').config({ path: '../../.env' }) — loads first
#   • Python agents: load_dotenv() — CWD is Experient root when started via npm run dev
#
# To generate a secure internal key:
#   openssl rand -hex 32
#
# ── Shared Secrets (read by both backend + agents) ──────────────────────────────
# CRITICAL: Both services must use the SAME value. The default below works for
# local dev with no .env file — it matches both code defaults. In staging/prod,
# override this with a strong random key and set it in both service environments.
AGENTS_INTERNAL_KEY=dev-internal-key-change-in-prod
AGENTS_URL=http://localhost:8001
# BACKEND_INTERNAL_URL=http://localhost:3001

# ── AI Keys ─────────────────────────────────────────────────────────────────────
# Required for AI survey generation and insights (Node backend)
OPENROUTER_API_KEY=sk-or-...

# Required for agents service in staging + prod
ANTHROPIC_API_KEY=sk-ant-...

# ── Database ─────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/xperiq
# DB_CONNECTION_TIMEOUT_MS=10000
AGENTS_DB_DSN=postgresql://postgres:postgres@localhost:5432/xperiq

# ── Redis ────────────────────────────────────────────────────────────────────────
# Optional — rate limiter falls back to in-memory (not suitable for multi-instance)
REDIS_URL=redis://localhost:6379

# ── Auth (Clerk) ─────────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_...
# Frontend key (set in app/.env.local, not here — Vite reads from app/)
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# ── Backend ──────────────────────────────────────────────────────────────────────
BACKEND=local
PORT=3001
# SKIP_AUTH=true    # LOCAL DEV ONLY — never set in staging/prod

# ── Agents Service ───────────────────────────────────────────────────────────────
# dev       → free OpenRouter models, colorized logs, DEBUG level, hot-reload
# dev-paid  → cheap paid OpenRouter models
# staging   → Anthropic Sonnet + Haiku (~$0.01/run)
# prod      → Anthropic Opus 4.7 + Haiku (~$0.05-0.10/run)
AGENTS_ENV=dev
AGENTS_PORT=8001
AGENTS_HOST=0.0.0.0
MAX_TOKENS_PER_RUN=50000
MAX_DAILY_SPEND_USD=0

# ── Insight pipeline tuning (backend) ───────────────────────────────────────────
# Daily rate limits — evaluated once at startup; change requires restart.
# REFRESH_DAILY_LIMIT=5           # max Refresh button presses per survey per day
# MANUAL_DAILY_RUN_LIMIT=10       # max Expert + Quick runs per survey per day

# ── Workflow Automation (Xperiq Actions) ────────────────────────────────────────
# Per-org connector credentials vault (backend/src/lib/workflowCredentials.ts).
# 32-byte AES-256-GCM key (hex — 64 chars — or base64). Generate with: openssl rand -hex 32
# Absent in dev ⇒ vault disabled, connectors fall back to the shared env vars below.
# WORKFLOW_CREDENTIALS_KEY=

# Shared fallback creds for the Zendesk connector (used only when an org has no
# per-org credentials in the vault above).
# ZENDESK_SUBDOMAIN=
# ZENDESK_EMAIL=
# ZENDESK_API_TOKEN=

# Async workflow-trigger queue (Redis Streams, lib/workflowQueue.ts). Optional
# overrides — safe defaults if unset.
# WORKFLOW_TRIGGER_STREAM=workflow:triggers
# WORKFLOW_RETRY_BASE_MS=30000
# WORKFLOW_RETRY_FACTOR=2
# WORKFLOW_MAX_ATTEMPTS=5

# Approval TTL — simple expiry + re-notify (never auto-reject), scheduler job
# jobs/reNotifyStaleApprovals.ts. See docs/automation-hub/DEEP_AUDIT_PM_FINDINGS.md §7a.
# WORKFLOW_APPROVAL_RENOTIFY_HOURS=72
# JOB_RENOTIFY_STALE_APPROVALS=true
# JOB_RENOTIFY_STALE_APPROVALS_SEC=3600

# ── Observability ────────────────────────────────────────────────────────────────
# SENTRY_DSN=https://...
# VITE_SENTRY_DSN=https://...    # Frontend — set in app/.env.local
